#!/usr/local/bin/ruby
# encoding: UTF-8

require 'fileutils'
require_relative '.utils'

def safe_system(*args)
  raise "Command failed: #{args.join(' ').inspect}" if not system(*args)
end

Dir.chdir(File.join(STEAM_ROOT_PATH, 'ubuntu12_32')) do
  lock = File.open('.lsu-runtime-upgrade.lock', File::RDWR | File::CREAT, 0600)
  lock.flock(File::LOCK_EX)

  runtime_md5 = File.exist?('steam-runtime/checksum')        ? File.read('steam-runtime/checksum').split(' ').first        : nil
  archive_md5 = File.exist?('steam-runtime.tar.xz.checksum') ? File.read('steam-runtime.tar.xz.checksum').split(' ').first : nil

  if archive_md5 && runtime_md5 != archive_md5

    if `/sbin/md5 -q steam-runtime.tar.xz`.chomp != archive_md5
      raise 'steam-runtime.tar.xz failed integrity check'
    end

    version_txt = `/usr/bin/tar -xf steam-runtime.tar.xz --to-stdout steam-runtime/version.txt`
    version_txt =~ /_([\d\.]+)$/
    version = $1

    raise if not version

    raise 'Invalid archive checksum' unless archive_md5.match?(/\A[0-9a-fA-F]{32}\z/)
    target = "steam-runtime_#{version}"
    if File.exist?(target) && File.file?("#{target}/checksum") && File.read("#{target}/checksum").split.first != archive_md5
      target = "#{target}_#{archive_md5}"
      raise "Conflicting runtime: #{target}" if File.exist?(target) && File.file?("#{target}/checksum") && File.read("#{target}/checksum").split.first != archive_md5
    end
    if !File.file?("#{target}/checksum") || File.read("#{target}/checksum").split.first != archive_md5
      raise "Incomplete active runtime: #{target}" if File.symlink?('steam-runtime') && File.readlink('steam-runtime') == target
      pwarn 'Extracting steam-runtime...'
      require 'tmpdir'
      tmp = Dir.mktmpdir('.steam-runtime-', '.')
      begin
        safe_system('tar', '-C', tmp, '-xf', 'steam-runtime.tar.xz', '--strip-components', '1')
        FileUtils.cp('steam-runtime.tar.xz.checksum', "#{tmp}/checksum")
        FileUtils.rm_rf(target)
        File.rename(tmp, target)
      ensure
        FileUtils.rm_rf(tmp)
      end
    end

    link = ".steam-runtime-link-#{Process.pid}"
    begin
      File.symlink(target, link)
      if File.exist?('steam-runtime') && !File.symlink?('steam-runtime')
        require 'tmpdir'
        backup = Dir.mktmpdir('.steam-runtime-previous-', '.')
        Dir.rmdir(backup)
        File.rename('steam-runtime', backup)
      end
      File.rename(link, 'steam-runtime')
    ensure
      FileUtils.rm_f(link)
    end
  end

  if not (File.exist?('steam-runtime/pinned_libs_32') && File.exist?('steam-runtime/pinned_libs_64'))
    EMUL_PATH = File.realdirpath(`sysctl -qn compat.linux.emul_path`).chomp
    safe_system(File.join(__dir__, 'lsu-freebsd-to-linux-env'), File.join(EMUL_PATH, 'bin/bash'), './steam-runtime/setup.sh')
  end

  # keep previous 2 versions just in case
  symlink_target = File.symlink?("steam-runtime") ? File.readlink("steam-runtime") : nil
  for dir in Dir['steam-runtime_*'].sort[0..-3] - [symlink_target]
    FileUtils.rm_r(dir)
  end
end
