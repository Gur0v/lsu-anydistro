.if !defined(OSVERSION)
OSVERSION != awk '/^\#define[[:blank:]]__FreeBSD_version/ {print $$3}' < /usr/include/sys/param.h # from bsd.port.mk
.endif
.if ${OSVERSION} < 1501000
.error FreeBSD 15.1 or newer is required
.endif

PROJECT = steam-utils

BUILD_DIR ?= .
PREFIX    ?= /usr/local
DESTDIR   ?=
LINUXBASE ?= /compat/linux
LINUX_CC  ?= ${LINUXBASE}/bin/cc

CFLAGS = -B${LINUXBASE}/bin --sysroot=${LINUXBASE} -std=c99 \
 -Wall -Wextra -Wno-unused-parameter -O2

LIBS  = lib32/steam/steamfix.so          \
        lib32/fakenm/libnm.so.0          \
        lib32/fakenm/libnm-glib.so.4     \
        lib32/fakepulse/libpulse.so.0    \
        lib64/fakepulse/libpulse.so.0    \
        lib32/fakeudev/libudev.so.0      \
        lib64/fakeudev/libudev.so.0      \
        lib32/fakeudev/libudev.so.1      \
        lib64/fakeudev/libudev.so.1      \
        lib64/dummy-uvm.so               \
        lib32/noepollexcl.so             \
        lib64/noepollexcl.so             \
        lib32/pathfix.so                 \
        lib64/pathfix.so                 \
        lib32/protonfix.so               \
        lib64/protonfix.so               \
        lib32/shmfix.so                  \
        lib64/shmfix.so                  \
        lib64/webfix.so                  \
        lib32/dt_init-fix.so

LIBS := ${LIBS:C|(.*)|$(BUILD_DIR)/\1|}

build: $(LIBS) $(BUILD_DIR)/bin/lsu-freebsd-to-linux-env $(BUILD_DIR)/lxbin/lsu-linux-to-freebsd-env

.for b in 32 64

$(BUILD_DIR)/lib$(b)/steam/steamfix.so: src/steamfix.c src/pathfix.c
	mkdir -p $(BUILD_DIR)/lib$(b)/steam
	${LINUX_CC} -m$(b) $(CFLAGS) -fPIC -shared -o $(.TARGET) src/steamfix.c src/pathfix.c -pthread -ldl -lm

$(BUILD_DIR)/lib$(b)/fakenm/libnm.so.0: src/fakenm.c
	mkdir -p $(BUILD_DIR)/lib$(b)/fakenm
	${LINUX_CC} -m$(b) $(CFLAGS) -fPIC -shared -o $(.TARGET) src/fakenm.c

$(BUILD_DIR)/lib$(b)/fakenm/libnm-glib.so.4: $(BUILD_DIR)/lib$(b)/fakenm/libnm.so.0
	ln -sf libnm.so.0 $(.TARGET)

$(BUILD_DIR)/lib$(b)/fakepulse/libpulse.so.0: src/fakepulse.c
	mkdir -p $(BUILD_DIR)/lib$(b)/fakepulse
	${LINUX_CC} -m$(b) $(CFLAGS) -fPIC -shared -o $(.TARGET) src/fakepulse.c

$(BUILD_DIR)/lib$(b)/fakeudev/libudev.so.0: src/fakeudev.c
	mkdir -p $(BUILD_DIR)/lib$(b)/fakeudev
	${LINUX_CC} -m$(b) $(CFLAGS) -fPIC -shared -o $(.TARGET) src/fakeudev.c

$(BUILD_DIR)/lib$(b)/fakeudev/libudev.so.1: $(BUILD_DIR)/lib$(b)/fakeudev/libudev.so.0
	ln -sf libudev.so.0 $(.TARGET)

$(BUILD_DIR)/lib$(b)/dummy-uvm.so: src/dummy-uvm.c
	mkdir -p $(BUILD_DIR)/lib$(b)
	${LINUX_CC} -m$(b) $(CFLAGS) -fPIC -shared -o $(.TARGET) src/dummy-uvm.c -ldl

$(BUILD_DIR)/lib$(b)/pathfix.so: src/pathfix.c
	mkdir -p $(BUILD_DIR)/lib$(b)
	${LINUX_CC} -m$(b) $(CFLAGS) -fPIC -shared -o $(.TARGET) src/pathfix.c -ldl

$(BUILD_DIR)/lib$(b)/protonfix.so: src/protonfix.c
	mkdir -p $(BUILD_DIR)/lib$(b)
	${LINUX_CC} -m$(b) $(CFLAGS) -fPIC -shared -o $(.TARGET) src/protonfix.c -pthread -ldl

$(BUILD_DIR)/lib$(b)/webfix.so: src/webfix.c
	mkdir -p $(BUILD_DIR)/lib$(b)
	${LINUX_CC} -m$(b) $(CFLAGS) -fPIC -shared -o $(.TARGET) src/webfix.c -pthread -ldl -lm

$(BUILD_DIR)/lib$(b)/noepollexcl.so: src/noepollexcl.c
	mkdir -p $(BUILD_DIR)/lib$(b)
	${LINUX_CC} -m$(b) $(CFLAGS) -fPIC -shared -o $(.TARGET) src/noepollexcl.c -ldl

$(BUILD_DIR)/lib$(b)/shmfix.so: src/shmfix.c
	mkdir -p $(BUILD_DIR)/lib$(b)
	${LINUX_CC} -m$(b) $(CFLAGS) -fPIC -shared -o $(.TARGET) src/shmfix.c -ldl -lrt
.endfor

$(BUILD_DIR)/lib32/dt_init-fix.so: src/dt_init-fix.c
	mkdir -p $(BUILD_DIR)/lib32
	cc -m32 -mstack-alignment=16 -mstackrealign -std=c99 -Wall -Wextra -fPIC -shared -o $(.TARGET) src/dt_init-fix.c

# we want to run this as the first command in a Linux chroot, hence -static
$(BUILD_DIR)/bin/lsu-freebsd-to-linux-env: src/swap-env.c
	mkdir -p $(BUILD_DIR)/bin
	cc -std=c99 -Wall -Wextra -static -o $(.TARGET) src/swap-env.c -DFBSD_TO_LINUX

$(BUILD_DIR)/lxbin/lsu-linux-to-freebsd-env: src/swap-env.c
	mkdir -p $(BUILD_DIR)/lxbin
	${LINUX_CC} $(CFLAGS) -o $(.TARGET) src/swap-env.c -D_GNU_SOURCE

clean:
.for f in $(LIBS) $(BUILD_DIR)/bin/lsu-freebsd-to-linux-env $(BUILD_DIR)/lxbin/lsu-linux-to-freebsd-env
.  if exists($f)
	rm $f
.  endif
.endfor

install:
	install -d $(DESTDIR)$(PREFIX)/$(PROJECT)
	install -d $(DESTDIR)$(PREFIX)/$(PROJECT)/bin
	install -d $(DESTDIR)$(PREFIX)/$(PROJECT)/lib32
	install -d $(DESTDIR)$(PREFIX)/$(PROJECT)/lib64
	install -d $(DESTDIR)$(PREFIX)/$(PROJECT)/lxbin
.for f in $(LIBS)
	install -d `dirname $(DESTDIR)$(PREFIX)/$(PROJECT)/${f:C|$(BUILD_DIR)/(.*)|\1|}`
	install $(f) $(DESTDIR)$(PREFIX)/$(PROJECT)/${f:C|$(BUILD_DIR)/(.*)|\1|}
.endfor
	install bin/.dpkgs.rb bin/.utils.rb bin/lsu-* bin/steam $(DESTDIR)$(PREFIX)/$(PROJECT)/bin
	install $(BUILD_DIR)/bin/lsu-freebsd-to-linux-env $(DESTDIR)$(PREFIX)/$(PROJECT)/bin
	install $(BUILD_DIR)/lxbin/lsu-linux-to-freebsd-env $(DESTDIR)$(PREFIX)/$(PROJECT)/lxbin
	install \
 lxbin/curl-config \
 lxbin/dbus-launch \
 lxbin/file* \
 lxbin/lsof* \
 lxbin/lspci \
 lxbin/lsu-* \
 lxbin/tar \
 lxbin/xdg-open \
 lxbin/xdg-user-dir \
 lxbin/xrandr \
 lxbin/zenity \
 $(DESTDIR)$(PREFIX)/$(PROJECT)/lxbin
.for t in LSU_FreeBSD_Wine LSU_Proton_11_chroot LSU_Proton_8_chroot LSU_Scout_chroot LSU_Sniper_chroot
	install -d $(DESTDIR)$(PREFIX)/$(PROJECT)/tools/$(t)
	install -m 0644 tools/$(t)/compatibilitytool.vdf $(DESTDIR)$(PREFIX)/$(PROJECT)/tools/$(t)
	install -m 0644 tools/$(t)/toolmanifest.vdf      $(DESTDIR)$(PREFIX)/$(PROJECT)/tools/$(t)
	install tools/$(t)/run.sh tools/$(t)/*.rb $(DESTDIR)$(PREFIX)/$(PROJECT)/tools/$(t)
.endfor
	# Native Ruby is required even when Linuxulator resolves /usr/bin/env.
	for f in $(DESTDIR)$(PREFIX)/$(PROJECT)/bin/steam $(DESTDIR)$(PREFIX)/$(PROJECT)/bin/lsu-* $(DESTDIR)$(PREFIX)/$(PROJECT)/lxbin/*.rb $(DESTDIR)$(PREFIX)/$(PROJECT)/tools/*/*.rb; do \
	  if [ "$$(/usr/bin/head -n 1 "$$f")" = '#!/usr/bin/env ruby' ]; then \
	    /usr/bin/sed -i '' '1s|^#!/usr/bin/env ruby$$|#!$(PREFIX)/bin/ruby|' "$$f"; \
	  fi; \
	done

deinstall:
.if exists($(DESTDIR)$(PREFIX)/$(PROJECT))
	rm -r -I $(DESTDIR)$(PREFIX)/$(PROJECT)
.endif
